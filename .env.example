# Copy to .env for a local run, or enter these as the Portainer stack's Environment variables.
# Never commit real values.

# Telegram: create an app at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Sonarr / Radarr: Settings -> General -> API Key
SONARR_KEY=
RADARR_KEY=

# Plex (optional, used to refresh the library after a manual import)
PLEX_TOKEN=
